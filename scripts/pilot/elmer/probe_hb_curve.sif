! T133 Phase 0 probe — проверка синтаксиса H-B Curve в Elmer 26.2
! MagnetoDynamics2D solver.
!
! Цель: убедиться что ElmerSolver не fail'ит с "Unknown keyword: H-B Curve"
! и Newton-Raphson сходится на минимальной геометрии с минимальной 4-точечной
! H-B таблицей.
!
! Если synthax работает — берём этот pattern в production .sif.
!
! H-B Curve формат (на основе strings из MagnetoDynamics.so + общих Elmer
! material property conventions):
!   H-B Curve(N,2) = Real
!     H_1 B_1
!     H_2 B_2
!     ...
!   End
! Внутри solver интерполирует Cubic spline (см. strings "Cubic spline for H-B curve").

Header
  Mesh DB "." "mesh-elmer-probe"
End

Simulation
  Coordinate System = "Cartesian 2D"
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = "Steady state"
  Steady State Max Iterations = 1
  Output Intervals = 1
  Post File = "probe.ep"
End

Constants
  Permeability of Vacuum = Real 1.25663706143592e-6
End

! ===== Bodies =====
Body 1
  Name = "Iron"
  Target Bodies(1) = 1
  Equation = 1
  Material = 2
  Body Force = 1
End

Body 2
  Name = "Air"
  Target Bodies(1) = 2
  Equation = 1
  Material = 1
End

! ===== Materials =====
Material 1
  Name = "Air"
  Relative Permeability = Real 1.0
  Electric Conductivity = Real 0.0
End

Material 2
  Name = "IronFrohlich"
  Electric Conductivity = Real 0.0
  ! H-B Curve table — 4 points, simple Frohlich-like saturation.
  ! Стандартный Elmer-синтаксис tabulated property: Variable + Real + End.
  ! "Coupled iter" — итерация nonlinear coupled system; 2D solver
  ! принимает упрощённую форму без explicit variable name (см. strings
  ! "H-B Curve" без "H-B Curve Variable" в MagnetoDynamics2D.so).
  H-B Curve = Variable Coupled iter
    Real cubic
      0.0      0.0
      100.0    1.0
      500.0    1.5
      5000.0   1.8
    End
End

! ===== Body Force =====
Body Force 1
  Name = "PrimaryCurrent"
  Current Density = Real 1.0e5
End

! ===== Equation =====
Equation 1
  Name = "MagnetoDynamics2D"
  Active Solvers(2) = 1 2
End

! ===== Solver 1: A-V solver (nonlinear через H-B Curve) =====
Solver 1
  Equation = "MgDyn2D"
  Variable = "A"
  Variable DOFs = 1
  Procedure = "MagnetoDynamics2D" "MagnetoDynamics2D"

  Linear System Solver = "Iterative"
  Linear System Iterative Method = "BiCGStabL"
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = "ILU0"
  Linear System Residual Output = 100

  Nonlinear System Max Iterations = 50
  Nonlinear System Convergence Tolerance = 1.0e-5
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 0.7
End

! ===== Solver 2: SaveScalars — energy integral =====
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = "probe_scalars.dat"

  Variable 1 = "A"
  Operator 1 = "max abs"
End

! ===== Boundary Condition =====
! C2 probe: Dirichlet A=0 для anchor'а (Infinity BC тестируется отдельно
! в probe_infinity_bc.sif — это natural BC, требует additional anchor).
Boundary Condition 1
  Name = "Outer_Dirichlet"
  Target Boundaries(1) = 3   ! Gmsh Physical Curve tag 3 ("Outer"); ElmerGrid 14 2 не renumber'ит
  A = Real 0.0
End
