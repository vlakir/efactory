! T133 Phase 0 probe — C1 verification: Infinity BC + linear material.
!
! Цель: проверить, что Infinity BC boundary keyword распознан и Elmer
! применяет его как Robin-type (asymptotic / Kelvin transformation).
!
! Topology: reused probe_hb_curve.geo (Iron 0.5×0.5 в Air 2×2 box).
! Material: linear μ_r=1000 (constant, чтобы исключить nonlinear divergence).
! BC: Infinity BC = True на outer boundary + anchor Dirichlet на ОДНОЙ
! точке (нужен для singular system magnetostatic — anchor через point set).
!
! Конвергенция за один Picard iteration (linear); цель — Elmer не падает
! с "Unknown keyword: Infinity BC" и enforce'ит local matrix contribution
! на outer (см. strings "localmatrixinfinitybc" в MagnetoDynamics2D.so).

Header
  Mesh DB "." "mesh-elmer-probe"
End

Simulation
  Coordinate System = "Cartesian 2D"
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = "Steady state"
  Steady State Max Iterations = 1
  Output Intervals = 1
End

Constants
  Permeability of Vacuum = Real 1.25663706143592e-6
End

Body 1
  Name = "Iron"
  Target Bodies(1) = 1
  Equation = 1
  Material = 2
  Body Force = 1
End

Body 2
  Name = "Air"
  Target Bodies(1) = 2
  Equation = 1
  Material = 1
End

Material 1
  Name = "Air"
  Relative Permeability = Real 1.0
  Electric Conductivity = Real 0.0
End

Material 2
  Name = "Iron_Linear"
  Relative Permeability = Real 1000.0
  Electric Conductivity = Real 0.0
End

Body Force 1
  Name = "PrimaryCurrent"
  Current Density = Real 1.0e5
End

Equation 1
  Name = "MagnetoDynamics2D"
  Active Solvers(1) = 1
End

Solver 1
  Equation = "MgDyn2D"
  Variable = "A"
  Variable DOFs = 1
  Procedure = "MagnetoDynamics2D" "MagnetoDynamics2D"

  Linear System Solver = "Iterative"
  Linear System Iterative Method = "BiCGStabL"
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = "ILU0"

  Nonlinear System Max Iterations = 1
End

! ===== BC: Infinity BC keyword check =====
Boundary Condition 1
  Name = "Outer_Infinity"
  Target Boundaries(1) = 3   ! Gmsh Physical Curve tag 3 ("Outer")
  Infinity BC = Logical True
End
