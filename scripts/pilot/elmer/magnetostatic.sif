! T113 Phase 1 pilot — Elmer FEM 2D-planar magnetostatic for OPT 6П14П SE
!
! Cross-check к GetDP getdp/magnetostatic.pro на той же geometry.msh.
! Та же физика: linear μ_r=8000 для Iron, ±Jz в Primary/Secondary
! (Secondary reinterpreted как return-leg primary в 2D-planar, см.
! заметку в getdp/magnetostatic.pro).
!
! Lp вычисляется методом J·A (через SaveScalars body integral от A):
!   W_per_depth = ½ ∫ J·A dA = ½ · J_density · (∫_Primary A − ∫_Secondary A)
!   Lp          = 2 · W_per_depth · core_depth / I_ref²
!
! Параметры идентичны GetDP-формулировке:
!   N_primary    = 2500
!   I_ref        = 1.0 A
!   area_window  = 9.075e-3 · 30.3e-3 = 2.74972e-4 m²
!   J_density    = 9.0918e6 A/m²
!
! ElmerGrid: gmsh msh22 → Elmer mesh. Physical Surface tags 1-7 = bodies,
! Physical Curve tag 8 ("infinity") = единственная boundary → Boundary 1.

Header
  Mesh DB "." "mesh-elmer"
End

Simulation
  Coordinate System = "Cartesian 2D"
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = "Steady state"
  Steady State Max Iterations = 1
  Output Intervals = 1
  Post File = "mag.ep"
End

Constants
  Permeability of Vacuum = Real 1.25663706143592e-6
End

! ===== Bodies (ElmerGrid maps Physical Surface tags 1..7 → Body 1..7) =====

Body 1
  Name = "Core"
  Target Bodies(1) = 1
  Equation = 1
  Material = 2
End

Body 2
  Name = "Primary"
  Target Bodies(1) = 2
  Equation = 1
  Material = 1
  Body Force = 1
  Primary = Logical True   ! mask для SaveScalars body int (см. Solver 2)
End

Body 3
  Name = "Secondary"
  Target Bodies(1) = 3
  Equation = 1
  Material = 1
  Body Force = 2
  Secondary = Logical True ! mask для SaveScalars body int
End

Body 4
  Name = "GapCenter"
  Target Bodies(1) = 4
  Equation = 1
  Material = 1
End

Body 5
  Name = "GapLeft"
  Target Bodies(1) = 5
  Equation = 1
  Material = 1
End

Body 6
  Name = "GapRight"
  Target Bodies(1) = 6
  Equation = 1
  Material = 1
End

Body 7
  Name = "Air"
  Target Bodies(1) = 7
  Equation = 1
  Material = 1
End

! ===== Materials =====

Material 1
  Name = "Air"
  Relative Permeability = Real 1.0
  Electric Conductivity = Real 0.0
End

Material 2
  Name = "Nanoperm 8000 (linear initial-permeability approximation)"
  Relative Permeability = Real 8000.0
  Electric Conductivity = Real 0.0
End

! ===== Body Forces (Current Density Jz) =====

Body Force 1
  Name = "PrimaryCurrent_plus_Jz"
  Current Density = Real 9.09182e6
End

Body Force 2
  Name = "SecondaryCurrent_minus_Jz_return"
  Current Density = Real -9.09182e6
End

! ===== Equation: 2D magnetostatic =====

Equation 1
  Name = "MagnetoDynamics2D"
  Active Solvers(2) = 1 2
End

! ----- Solver 1: solve for magnetic vector potential A (z-component) -----
Solver 1
  Equation = "MgDyn2D"
  Variable = "A"
  Variable DOFs = 1
  Procedure = "MagnetoDynamics2D" "MagnetoDynamics2D"

  Linear System Solver = "Iterative"
  Linear System Iterative Method = "BiCGStabL"
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-10
  Linear System Preconditioning = "ILU0"
  Linear System Residual Output = 100

  Nonlinear System Max Iterations = 1
End

! ----- Solver 2: SaveScalars — body-wise ∫ A dA для энергии J·A метода -----
! ВАЖНО: solver должен быть в Active Solvers (см. выше), иначе Elmer не
! выполняет его даже с Exec Solver=After Simulation (steady-state с одним
! step'ом — default exec=always означает один раз после A).
!
! Дополнительный post-process solver (MagnetoDynamics2DCalcFields) для
! генерации B/H был бы диагностически полезен, но он отсутствует в
! Elmer 26.2 elmerfem-csc PPA build (Load: FATAL: Can't find procedure
! [MagnetoDynamics2DCalcFields]). Для J·A метода нужна только A, так что
! не блокирующий gap; B/H dump — можно сделать через ResultOutputSolver
! VTU как follow-up если потребуется визуализация.
Solver 2
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = "scalars.dat"

  Variable 1 = "A"
  Operator 1 = "body int"
  Mask Name 1 = "Primary"

  Variable 2 = "A"
  Operator 2 = "body int"
  Mask Name 2 = "Secondary"
End

! ===== Boundary Condition: A = 0 on outer "infinity" curve =====
! Physical Curve tag 8 in Gmsh → Boundary 1 in Elmer (renumbered by ElmerGrid).

Boundary Condition 1
  Name = "Infinity"
  Target Boundaries(1) = 1
  A = Real 0.0
End
