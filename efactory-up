#!/usr/bin/env bash
# efactory-up — unified entrypoint для запуска efactory-сессии (T114).
#
# Что делает:
#   1. Pre-flight (docker daemon, X11 при GUI-режиме, paths).
#   2. Bootstrap KiCad libraries (T121): при отсутствии $HOME/efactory-
#      libs/symbols/ — `docker pull` + `docker cp` из efactory-libs
#      image в host directory. Идемпотентно (no-op если уже есть).
#   3. xhost +SI:localuser:#$(id -u) (откатывается через trap EXIT).
#   4. `docker run --rm` efactory:linux с mount'ами state / projects /
#      libs / X11 / Xauthority и pass-through DISPLAY/LANG/LC_ALL.
#
# Usage:
#     ./efactory-up [OPTIONS] [-- KICAD_ARGS...]
#
# Options:
#     --pull            docker pull efactory:linux перед запуском.
#                       (Пока no-op для linux-dev — реальное название
#                       тэга появится после T115/CI с GHCR.)
#     --version         Показать EFACTORY_VERSION образа и выйти.
#     --headless        Запустить без GUI / X11 / libs (для CI / pytest).
#                       KICAD_ARGS становятся командой контейнера
#                       (default: `uv run pytest`).
#     --update-libs     Пересоздать $HOME/efactory-libs/ из текущего
#                       efactory-libs image (затирает старое содержимое).
#                       Не запускает GUI — отдельная команда.
#     --with-3dmodels   Использовать efactory-libs:linux-dev-3d (~4 GB)
#                       вместо slim (~400 MB). Применимо при первом
#                       bootstrap'е или --update-libs.
#     --demo            Открыть SE-amp 6П14П demo. Если фикстура не
#                       сгенерирована, запускает `gen-se-amp-demo.py`.
#     --demo-freecad    Открыть sheet-metal-bracket demo в FreeCAD GUI
#                       (T112). Если фикстура не сгенерирована —
#                       запускает gen-bracket-demo.FCMacro через `freecadcmd`
#                       внутри контейнера. Не тащит kicad-libs.
#                       Несовместимо с --demo.
#     --agent [NAME]    Запустить runtime-агента Claude Code в TUI (T013).
#                       Без X11/libs — только state + projects mount.
#                       Первый запуск — интерактивный `claude login` (OAuth);
#                       credentials кладутся в $HOME/efactory-state/claude/
#                       и переживают `docker rm`. Альтернатива — экспортировать
#                       ANTHROPIC_API_KEY на хосте перед запуском.
#                       Несовместимо с --demo, --demo-freecad, --headless.
#                       NAME (T016) — имя проекта в $HOME/efactory-projects/.
#                       Контейнер стартует с cwd=/workspace/NAME/; SessionStart
#                       hook генерирует динамический project context. Если NAME
#                       не указан — стартует в /workspace/ без активного
#                       проекта (агент увидит "No active project").
#     --reset-claude-state
#                       Перезаписать host state Claude Code (settings.json
#                       + commands/) embedded template'ом из образа (с
#                       backup *.bak-DATE/). Использовать после upgrade
#                       образа, если SessionStart hook (T016) перестал
#                       работать или новые slash-команды (T014) не
#                       появляются.
#     --reset-claude-settings  (deprecated alias of --reset-claude-state;
#                       будет удалён в следующем минорном релизе)
#     -h, --help        Показать help и выйти.
#
# Env:
#     EFACTORY_IMAGE        Main image (default efactory:linux).
#     EFACTORY_LIBS_IMAGE   Override libs image tag (default
#                           efactory-libs:linux-dev[-3d]).
#     EFACTORY_STATE_DIR    Persistent state dir (default
#                           $HOME/efactory-state).
#     EFACTORY_PROJECTS_DIR Projects dir (default $HOME/efactory-projects).
#     EFACTORY_LIBS_DIR     Libraries dir (default $HOME/efactory-libs).
#     EFACTORY_KICAD_BIN    Какой бинарь стартовать в GUI режиме
#                           (default kicad).

set -euo pipefail

# ── Defaults ───────────────────────────────────────────────────────────────
IMAGE="${EFACTORY_IMAGE:-efactory:linux}"
STATE_DIR="${EFACTORY_STATE_DIR:-$HOME/efactory-state}"
PROJECTS_DIR="${EFACTORY_PROJECTS_DIR:-$HOME/efactory-projects}"
LIBS_DIR="${EFACTORY_LIBS_DIR:-$HOME/efactory-libs}"
KICAD_BIN="${EFACTORY_KICAD_BIN:-kicad}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Flags
DO_PULL=0
SHOW_VERSION=0
HEADLESS=0
UPDATE_LIBS=0
WITH_3DMODELS=0
DEMO_MODE=0
DEMO_FREECAD_MODE=0
AGENT_MODE=0
AGENT_PROJECT=""
RESET_CLAUDE_STATE=0
PASS_ARGS=()

log() { printf '[efactory-up] %s\n' "$*" >&2; }
fail() { log "FAIL: $*"; exit 1; }

usage() {
    sed -n '2,65p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

# ── Arg parsing ────────────────────────────────────────────────────────────
while (( $# )); do
    case "$1" in
        --pull)          DO_PULL=1; shift ;;
        --version)       SHOW_VERSION=1; shift ;;
        --headless)      HEADLESS=1; shift ;;
        --update-libs)   UPDATE_LIBS=1; shift ;;
        --with-3dmodels) WITH_3DMODELS=1; shift ;;
        --demo)          DEMO_MODE=1; shift ;;
        --demo-freecad)  DEMO_FREECAD_MODE=1; shift ;;
        --agent)
            # T016 — `--agent [NAME]`: optional positional NAME, не другой
            # флаг и не `--` (separator). Если NAME отсутствует, агент
            # стартует в /workspace без активного проекта.
            AGENT_MODE=1
            shift
            if (( $# > 0 )) && [[ "$1" != --* && "$1" != "--" ]]; then
                AGENT_PROJECT="$1"
                shift
            fi
            ;;
        --reset-claude-state)
            RESET_CLAUDE_STATE=1; shift ;;
        --reset-claude-settings)
            # Deprecated alias (T014 rename). Удалим в следующем minor релизе.
            log "WARNING: --reset-claude-settings deprecated, use --reset-claude-state"
            RESET_CLAUDE_STATE=1; shift ;;
        -h|--help)       usage ;;
        --)              shift; PASS_ARGS+=("$@"); break ;;
        *)               PASS_ARGS+=("$1"); shift ;;
    esac
done

if (( DEMO_MODE && DEMO_FREECAD_MODE )); then
    fail "--demo и --demo-freecad взаимоисключающи (KiCad/FreeCAD — разные binaries)"
fi

if (( AGENT_MODE && ( DEMO_MODE || DEMO_FREECAD_MODE || HEADLESS ) )); then
    fail "--agent взаимоисключающ с --demo / --demo-freecad / --headless (разные LAUNCH_BIN / режимы запуска)"
fi

# T016 — `--reset-claude-settings` без `--agent` допустим как standalone
# команда: сбросить settings.json embedded template'ом и выйти.
if (( RESET_CLAUDE_STATE && DEMO_MODE )); then
    fail "--reset-claude-state и --demo несовместимы (--reset работает только в context'е --agent или standalone)"
fi
if (( RESET_CLAUDE_STATE && DEMO_FREECAD_MODE )); then
    fail "--reset-claude-state и --demo-freecad несовместимы"
fi
if (( RESET_CLAUDE_STATE && HEADLESS )); then
    fail "--reset-claude-state и --headless несовместимы"
fi

# `--dangerously-skip-permissions` (Claude Code CLI) отказывается работать
# под root. Контейнер запускается под `ubuntu` (uid=1000) — но если кто-то
# запустит этот скрипт через sudo с root-HOME / env, эвристически предупредим.
if (( AGENT_MODE )) && [[ $(id -u) -eq 0 ]]; then
    fail "--agent: hostный uid=0 (sudo?). Claude Code --dangerously-skip-permissions откажется работать под root. Запусти без sudo."
fi

if (( WITH_3DMODELS )); then
    LIBS_IMAGE_DEFAULT="efactory-libs:linux-dev-3d"
else
    LIBS_IMAGE_DEFAULT="efactory-libs:linux-dev"
fi
LIBS_IMAGE="${EFACTORY_LIBS_IMAGE:-$LIBS_IMAGE_DEFAULT}"

# ── Pre-flight ─────────────────────────────────────────────────────────────
command -v docker >/dev/null || fail "docker не найден в PATH"
docker info >/dev/null 2>&1 || fail "docker daemon не отвечает"
docker image inspect "$IMAGE" >/dev/null 2>&1 \
    || fail "Образ $IMAGE не найден; собери: docker build -t $IMAGE ."

# ── --pull / --version (раннее завершение) ─────────────────────────────────
if (( DO_PULL )); then
    log "docker pull $IMAGE (no-op для local linux-dev — реальный pull появится с T115/CI)"
    docker pull "$IMAGE" 2>&1 | tail -3 || log "pull failed (probably local-only tag)"
fi

if (( SHOW_VERSION )); then
    docker run --rm "$IMAGE" bash -lc 'echo "efactory $EFACTORY_VERSION"'
    exit 0
fi

# ── Libs bootstrap (T121) ──────────────────────────────────────────────────
bootstrap_libs() {
    local target="$1"
    log "bootstrap libraries из $LIBS_IMAGE → $target"

    if ! docker image inspect "$LIBS_IMAGE" >/dev/null 2>&1; then
        local build_args=""
        if (( WITH_3DMODELS )); then
            build_args="--build-arg INCLUDE_3DMODELS=1 "
        fi
        fail "Libs image $LIBS_IMAGE не найден; собери: docker build -f Dockerfile.libs ${build_args}-t $LIBS_IMAGE ."
    fi

    mkdir -p "$target"
    local container
    container="$(docker create "$LIBS_IMAGE")"
    trap "docker rm '$container' >/dev/null 2>&1 || true" RETURN

    for sub in symbols footprints template 3dmodels; do
        rm -rf "$target/$sub" "$target/$sub.tmp"
        # docker cp всегда копирует в parent — даёт `$target/$sub`.
        if docker cp "$container:/$sub" "$target/$sub" 2>/dev/null; then
            log "  + $sub ($(du -sh "$target/$sub" 2>/dev/null | cut -f1))"
        else
            log "  - $sub отсутствует в образе (OK для slim, ожидаемо)"
        fi
    done
    trap - RETURN
    docker rm "$container" >/dev/null

    # При первом bootstrap затираем user-level sym-lib-table / fp-lib-table:
    # они могли быть созданы пустыми, когда libraries в образе отсутствовали
    # (T111 known limitation). После bootstrap KiCad перезагрузит дефолтные
    # таблицы из /usr/share/kicad/{symbols,footprints}/sym-lib-table /
    # fp-lib-table. Безопасно: пользователь ещё ничего не добавлял —
    # таблицы пустые и stub-овые.
    local kicad_cfg="$STATE_DIR/config/kicad/10.0"
    if [[ -d "$kicad_cfg" ]]; then
        rm -f "$kicad_cfg/sym-lib-table" "$kicad_cfg/fp-lib-table"
        log "  → user sym/fp-lib-table сброшены (re-init из system default)"
    fi
}

if (( UPDATE_LIBS )); then
    bootstrap_libs "$LIBS_DIR"
    log "libs обновлены. Запустить GUI: ./efactory-up"
    exit 0
fi

# Auto-bootstrap при первом запуске (нет symbols/ — значит libs не extracted).
# Пропускаем для --demo-freecad: bracket-demo не использует KiCad-libs, нет
# смысла тащить 400+ MB ради FreeCAD-only сценария.
if [[ ! -d "$LIBS_DIR/symbols" ]] && (( ! DEMO_FREECAD_MODE )); then
    bootstrap_libs "$LIBS_DIR"
fi

# ── --demo: материализовать SE-amp demo при отсутствии ─────────────────────
DEMO_DIR_HOST="$PROJECTS_DIR/se-amp-demo"
if (( DEMO_MODE )); then
    if [[ ! -f "$DEMO_DIR_HOST/se_amp.kicad_pro" ]]; then
        log "demo не найден — генерирую через scripts/gen-se-amp-demo.py"
        ( cd "$REPO_ROOT" && uv run python scripts/gen-se-amp-demo.py ) \
            || fail "генератор demo упал; запусти руками: uv run python scripts/gen-se-amp-demo.py"
    fi
    PASS_ARGS=(/workspace/se-amp-demo/se_amp.kicad_pro "${PASS_ARGS[@]}")
fi

# ── --demo-freecad: материализовать sheet-metal-bracket при отсутствии ─────
# Генератор требует FreeCAD API → запускаем через `freecadcmd` внутри
# контейнера (host у пользователя FreeCAD не имеет). Один docker run без
# X11 / libs — изолированная build-step. PROJECTS_DIR mount позволяет
# результирующему .FCStd попасть на host для последующего GUI-запуска.
FREECAD_DEMO_DIR_HOST="$PROJECTS_DIR/sheetmetal-bracket-demo"
LAUNCH_BIN="$KICAD_BIN"
if (( DEMO_FREECAD_MODE )); then
    mkdir -p "$PROJECTS_DIR"
    if [[ ! -f "$FREECAD_DEMO_DIR_HOST/bracket.FCStd" ]]; then
        log "bracket demo не найден — генерирую через freecadcmd внутри контейнера"
        docker run --rm \
            -v "$PROJECTS_DIR:/workspace:rw" \
            --user "$(id -u):$(id -g)" \
            "$IMAGE" \
            freecadcmd /opt/efactory/scripts/gen-bracket-demo.FCMacro \
            || fail "генератор bracket-demo упал"
    fi
    LAUNCH_BIN="freecad"
    PASS_ARGS=(/workspace/sheetmetal-bracket-demo/bracket.FCStd "${PASS_ARGS[@]}")
fi

# ── Headless режим (CI / pytest) — без GUI, без libs ───────────────────────
if (( HEADLESS )); then
    cmd=("uv" "run" "pytest")
    if (( ${#PASS_ARGS[@]} > 0 )); then
        cmd=("${PASS_ARGS[@]}")
    fi
    exec docker run --rm "$IMAGE" "${cmd[@]}"
fi

# ── Claude Code state bootstrap (T016 settings + T014 commands) ────────────
# Bootstrap-step для AGENT_MODE и standalone --reset-claude-state.
# Materializes на хосте:
#   - settings.json (SessionStart hook → project context, T016)
#   - commands/*.md (efactory custom slash-команды, T014)
# Persist mount $STATE_DIR/claude:/efactory/.claude/ перетрёт запечённые
# в образе пути; материализуем дефолты **на хосте** при первом запуске
# или при --reset-claude-state (с backup).
#
# Источник дефолта (приоритет):
#   1) $REPO_ROOT/docker/runtime-agent-{settings.json,commands/} — если
#      есть (dev: репо под рукой, никаких docker run).
#   2) /opt/efactory/share/claude-defaults/{settings.json,commands/} в
#      образе — fallback когда репо отсутствует (production: distribute
#      только image).
bootstrap_claude_state() {
    local force="${1:-0}"
    local target_dir="$STATE_DIR/claude"
    local target_settings="$target_dir/settings.json"
    local target_commands="$target_dir/commands"
    mkdir -p "$target_dir"

    local need_bootstrap=0
    if [[ ! -f "$target_settings" ]] || [[ ! -d "$target_commands" ]]; then
        need_bootstrap=1
    fi
    if (( force == 0 && need_bootstrap == 0 )); then
        return 0
    fi

    if (( force == 1 )); then
        local backup_dir="$target_dir.bak-$(date +%Y-%m-%d)"
        mkdir -p "$backup_dir"
        [[ -f "$target_settings" ]] && cp -f "$target_settings" "$backup_dir/"
        [[ -d "$target_commands" ]] && cp -rf "$target_commands" "$backup_dir/"
        log "Claude state reset: backup → $backup_dir/"
        rm -rf "$target_commands"
    fi

    local src_settings_repo="$REPO_ROOT/docker/runtime-agent-settings.json"
    local src_commands_repo="$REPO_ROOT/docker/runtime-agent-commands"
    if [[ -f "$src_settings_repo" && -d "$src_commands_repo" ]]; then
        cp -f "$src_settings_repo" "$target_settings"
        mkdir -p "$target_commands"
        cp -f "$src_commands_repo"/*.md "$target_commands/"
        log "Claude state bootstrapped из репо (settings.json + $(ls "$src_commands_repo" | wc -l) команд)"
    else
        # Fallback: docker create + cp из образа.
        local container
        container="$(docker create "$IMAGE")"
        local ok=1
        docker cp \
                "$container:/opt/efactory/share/claude-defaults/settings.json" \
                "$target_settings" 2>/dev/null || ok=0
        mkdir -p "$target_commands"
        docker cp \
                "$container:/opt/efactory/share/claude-defaults/commands/." \
                "$target_commands/" 2>/dev/null || ok=0
        docker rm "$container" >/dev/null 2>&1 || true
        if (( ok == 0 )); then
            fail "Не удалось материализовать Claude state (репо отсутствует, в образе тоже нет /opt/efactory/share/claude-defaults/ — пересобери image)"
        fi
        log "Claude state bootstrapped из образа ($IMAGE)"
    fi
}

# T134: KB host-mutated директория (built-in seed запекается в образ под
# /efactory/knowledge-base/built-in/). Bind-mount только host-mutated;
# built-in остаётся read-only в образе. --reset-claude-state также
# чистит host-mutated KB (с backup).
bootstrap_kb_state() {
    local force="${1:-0}"
    local target_dir="$STATE_DIR/knowledge-base"
    mkdir -p "$target_dir"

    if (( force == 1 )) && [[ -d "$target_dir" ]] && [[ -n "$(ls -A "$target_dir" 2>/dev/null)" ]]; then
        local backup_dir="$target_dir.bak-$(date +%Y-%m-%d)"
        mkdir -p "$backup_dir"
        cp -rf "$target_dir"/. "$backup_dir/" 2>/dev/null || true
        log "KB host-mutated reset: backup → $backup_dir/"
        rm -rf "$target_dir"
        mkdir -p "$target_dir"
    fi
}

if (( RESET_CLAUDE_STATE && ! AGENT_MODE )); then
    # Standalone сброс — не запускаем агента.
    bootstrap_claude_state 1
    bootstrap_kb_state 1
    log "Готово. Запусти агента: ./efactory-up --agent [NAME]"
    exit 0
fi

# ── Agent режим (Claude Code TUI) — T013 + T016 ────────────────────────────
# Без X11, без libs (агент не обращается напрямую к KiCad-libs — они
# доступны через `kicad-cli` который сам найдёт их в `/usr/share/kicad/`,
# но Symbol Library Browser не нужен в TUI-сценарии). State + projects
# mount, опциональный ANTHROPIC_API_KEY passthrough. `-it` для TUI.
#
# T016 — позиционный AGENT_PROJECT:
#   - если задан, cwd контейнера = /workspace/$AGENT_PROJECT, pre-flight
#     проверяет существование $PROJECTS_DIR/$AGENT_PROJECT;
#   - если пуст, cwd = /workspace (SessionStart hook выведет «No active
#     project, available: ...»).
if (( AGENT_MODE )); then
    mkdir -p "$STATE_DIR/claude" "$PROJECTS_DIR"

    AGENT_CWD="/workspace"
    if [[ -n "$AGENT_PROJECT" ]]; then
        if [[ ! -d "$PROJECTS_DIR/$AGENT_PROJECT" ]]; then
            available="$(cd "$PROJECTS_DIR" 2>/dev/null \
                && ls -1d */ 2>/dev/null | sed 's:/$::' | paste -sd', ' || echo '(пусто)')"
            fail "Проект '$AGENT_PROJECT' не найден в $PROJECTS_DIR. Доступно: $available"
        fi
        AGENT_CWD="/workspace/$AGENT_PROJECT"
    fi

    bootstrap_claude_state "$RESET_CLAUDE_STATE"
    bootstrap_kb_state "$RESET_CLAUDE_STATE"

    AGENT_ENV_ARGS=()
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
        AGENT_ENV_ARGS+=(-e "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
        log "ANTHROPIC_API_KEY проброшен в контейнер (usage-based billing)"
    fi
    log "agent cwd = $AGENT_CWD"

    # `--append-system-prompt "$(cat /CLAUDE.md)"` — явная подгрузка
    # runtime-агентского system prompt. Claude Code 2.1.150 auto-discovery
    # CLAUDE.md из parent-trail CWD=/workspace до / в нашем layout не
    # сработал (Analyzed issue #2 в T013 spec'е); явное указание через флаг —
    # надёжно и не зависит от поиска по файловой системе.
    # bash -c обёртка нужна для $(cat) интерполяции внутри контейнера.
    exec docker run --rm -it \
        "${AGENT_ENV_ARGS[@]}" \
        -v "$STATE_DIR/claude:/efactory/.claude:rw" \
        -v "$STATE_DIR/knowledge-base:/efactory/knowledge-base/host-mutated:rw" \
        -v "$PROJECTS_DIR:/workspace:rw" \
        -w "$AGENT_CWD" \
        "$IMAGE" \
        bash -c 'exec claude --dangerously-skip-permissions --append-system-prompt "$(cat /CLAUDE.md)" "$@"' \
        bash "${PASS_ARGS[@]}"
fi

# ── GUI: pre-flight для X11 ────────────────────────────────────────────────
XAUTH_HOST="${XAUTHORITY:-$HOME/.Xauthority}"
[[ -n "${DISPLAY:-}" ]] || fail "DISPLAY пустой — нет X11 сессии (используй --headless для CI)"
[[ -r "$XAUTH_HOST" ]] || fail "XAUTHORITY=$XAUTH_HOST не читается"
command -v xhost >/dev/null || fail "xhost не найден в PATH (поставь x11-xserver-utils)"

# State и projects mounts: создаём если нет.
# `claude/` — runtime-агент Claude Code (auto-memory, settings, todos,
# projects). См. docs/container-boundary.md.
mkdir -p "$STATE_DIR/config" "$STATE_DIR/cache" "$STATE_DIR/local" \
    "$STATE_DIR/claude" "$PROJECTS_DIR"

# Опциональный GPU passthrough.
DRI_ARGS=()
[[ -e /dev/dri ]] && DRI_ARGS=(--device /dev/dri:/dev/dri)

# Locale pass-through: только заданные переменные (см. discussion в T111).
LOCALE_ARGS=()
[[ -n "${LANG:-}" ]] && LOCALE_ARGS+=(-e "LANG=$LANG")
[[ -n "${LC_ALL:-}" ]] && LOCALE_ARGS+=(-e "LC_ALL=$LC_ALL")
[[ -n "${LANGUAGE:-}" ]] && LOCALE_ARGS+=(-e "LANGUAGE=$LANGUAGE")

# Libraries mounts: каждая subdir отдельно (template — singular в KiCad).
# 3dmodels mount'ится только если непустой.
LIBS_ARGS=()
for sub in symbols footprints template; do
    [[ -d "$LIBS_DIR/$sub" ]] && LIBS_ARGS+=(-v "$LIBS_DIR/$sub:/usr/share/kicad/$sub:ro")
done
if [[ -d "$LIBS_DIR/3dmodels" ]] && [[ -n "$(ls -A "$LIBS_DIR/3dmodels" 2>/dev/null)" ]]; then
    LIBS_ARGS+=(-v "$LIBS_DIR/3dmodels:/usr/share/kicad/3dmodels:ro")
fi

# xhost +SI узким правилом; trap откатывает на EXIT.
HOST_UID="$(id -u)"
xhost "+SI:localuser:#${HOST_UID}" >/dev/null
trap 'xhost "-SI:localuser:#${HOST_UID}" >/dev/null || true' EXIT

# `docker run --rm`: state / projects / libs / X11 / Xauthority + локали.
exec docker run --rm \
    -e DISPLAY \
    "${LOCALE_ARGS[@]}" \
    -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
    -v "$XAUTH_HOST:/efactory/.Xauthority:ro" \
    -v "$STATE_DIR/config:/opt/efactory/.config:rw" \
    -v "$STATE_DIR/cache:/opt/efactory/.cache:rw" \
    -v "$STATE_DIR/local:/opt/efactory/.local:rw" \
    -v "$STATE_DIR/claude:/efactory/.claude:rw" \
    -v "$PROJECTS_DIR:/workspace:rw" \
    "${LIBS_ARGS[@]}" \
    "${DRI_ARGS[@]}" \
    "$IMAGE" \
    "$LAUNCH_BIN" "${PASS_ARGS[@]}"
